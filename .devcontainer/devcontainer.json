{
  "name": "PS-ETW Python Backend",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "portsAttributes": {
    "5000": {
      "label": "PS-ETW Backend",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [5000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
